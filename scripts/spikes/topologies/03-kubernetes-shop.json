        { "id": "grafana", "name": "Grafana", "icon": "grafana" }
      ] }
    ] },
    { "type": "group", "kind": "group", "id": "managed", "name": "Managed data services", "items": [
      { "id": "postgres", "name": "PostgreSQL", "icon": "postgresql", "detail": "HA pair" },
      { "id": "redis", "name": "Redis", "icon": "redis", "detail": "Session cache" },
      { "id": "kafka", "name": "Kafka", "icon": "kafka", "detail": "3 brokers" }
    ] },
    { "id": "psp", "name": "Payment provider", "icon": "api" }
  ],
  "connections": [
    { "from": "shoppers", "to": "ingress", "meaning": "request", "label": "HTTPS 443", "step": "1" },
    { "from": "ingress", "to": "web", "meaning": "request", "label": "HTTP", "step": "2" },
    { "from": "web", "to": "api", "meaning": "request", "label": "gRPC", "step": "3" },
    { "from": "web", "to": "cart", "meaning": "request", "label": "gRPC" },
    { "from": "api", "to": "postgres", "meaning": "request", "label": "TCP 5432", "step": "4" },
    { "from": "cart", "to": "redis", "meaning": "request", "label": "TCP 6379" },
    { "from": "cart", "to": "payments", "meaning": "request", "label": "gRPC", "step": "5" },
    { "from": "payments", "to": "psp", "meaning": "request", "label": "HTTPS" },
    { "from": "payments", "to": "payments-secret", "meaning": "management", "label": "mounted" },
    { "from": "payments", "to": "kafka", "meaning": "async", "label": "order-paid events" },
    { "from": "prometheus", "to": "api", "meaning": "monitoring", "label": "scrape" },
    { "from": "grafana", "to": "prometheus", "meaning": "request", "label": "PromQL" }
