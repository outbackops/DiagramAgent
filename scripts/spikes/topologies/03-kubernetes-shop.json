{
  "version": 1,
  "title": "Shop platform on Kubernetes",
  "subtitle": "Ingress, three service namespaces and managed data outside the cluster",
  "platform": "kubernetes",
  "view": "application",
  "items": [
    { "id": "shoppers", "name": "Shoppers", "icon": "users" },
    { "type": "group", "kind": "cluster", "id": "cluster", "name": "Production cluster", "facts": "3 node pools · v1.30", "items": [
      { "type": "group", "kind": "namespace", "id": "ns-ingress", "name": "ingress-nginx", "items": [
        { "id": "ingress", "name": "Ingress controller", "icon": "k8s-ingress", "detail": "2 replicas" }
      ] },
      { "type": "group", "kind": "namespace", "id": "ns-shop", "name": "shop", "items": [
        { "id": "web", "name": "storefront", "icon": "k8s-deployment", "detail": "3 replicas" },
        { "id": "api", "name": "catalog-api", "icon": "k8s-deployment", "detail": "4 replicas · HPA" },
        { "id": "cart", "name": "cart", "icon": "k8s-statefulset", "detail": "3 replicas" }
      ] },
      { "type": "group", "kind": "namespace", "id": "ns-pay", "name": "payments", "items": [
        { "id": "payments", "name": "payments", "icon": "k8s-deployment", "detail": "2 replicas" },
