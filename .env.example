# DiagramAgent configuration — copy to .env.local and set only what you need.
#
# Nothing is required for local use: sign in once with `gh auth login --web`
# (or `copilot login`) and run `npm run dev`. Never commit real values.

# ---------------------------------------------------------------------------
# Models (GitHub Copilot)
# ---------------------------------------------------------------------------
# Default model for new users, as provider:model@reasoning-effort.
# DIAGRAM_AGENT_DEFAULT_MODEL=copilot:claude-opus-5.5@medium

# ---------------------------------------------------------------------------
# Sign-in
# ---------------------------------------------------------------------------
# In-app "Sign in with GitHub" (OAuth device flow). Register a GitHub OAuth App
# (or GitHub App) with "Enable Device Flow" checked. Only the client ID is
# needed — it is a public identifier, not a secret.
# GITHUB_OAUTH_CLIENT_ID=

# 32+ random characters used to encrypt the session cookie. Required in
# production when in-app sign-in is enabled. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DIAGRAM_AGENT_SESSION_SECRET=

# Let requests without an in-app sign-in use the GitHub account signed in on
# the server machine. Defaults to true for `next dev`, false for production.
# DIAGRAM_AGENT_ALLOW_MACHINE_LOGIN=

# Where the Copilot runtime keeps its state (default: <tmp>/diagram-agent/copilot).
# DIAGRAM_AGENT_COPILOT_HOME=

# ---------------------------------------------------------------------------
# Optional: Azure OpenAI / AI Foundry deployments (Microsoft Entra ID, no keys)
# ---------------------------------------------------------------------------
# Authenticates with DefaultAzureCredential (az login, managed identity, ...).
# AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.openai.azure.com
