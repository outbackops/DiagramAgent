              }

              UDR_Mgmt.class: resource
              UDR_Mgmt: {
                icon: settings
                label: "rt-mgmt: 0/0 → FW"
              }
            }
          }

          HubServices.class: resource_group
          HubServices: {
            label: HUB PLATFORM SERVICES (NON-VNET)
            grid-columns: 4

            FirewallPolicy.class: resource
            FirewallPolicy: {
              icon: azure-policy
              label: "Firewall Policy (IDPS, TLS Inspection)"
