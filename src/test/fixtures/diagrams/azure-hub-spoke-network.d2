                icon: azure-virtual-machine
                label: AD DS Domain Controllers
              }

              NSG_Shared.class: resource
              NSG_Shared: {
                icon: azure-network-security-groups
                label: nsg-shared
              }

              UDR_Shared.class: resource
              UDR_Shared: {
                icon: settings
                label: "rt-shared: 0/0 → FW"
              }
            }

            ManagementSubnet.class: subnet
            ManagementSubnet: {
              label: "SNET-MANAGEMENT (10.0.5.0/24)"
              grid-columns: 2

              JumpBox.class: resource
