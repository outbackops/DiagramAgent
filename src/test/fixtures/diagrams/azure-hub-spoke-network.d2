AzureTenant.class: region
AzureTenant: {
  label: "AZURE TENANT (CONTOSO)"
  direction: right

  Platform.class: region
  Platform: {
    label: PLATFORM MANAGEMENT GROUP
    direction: down
    style.stroke-dash: 4

    ConnectivitySubscription.class: subscription
    ConnectivitySubscription: {
      label: CONNECTIVITY SUBSCRIPTION

      AustraliaEast.class: region
      AustraliaEast: {
        label: "REGION: AUSTRALIA EAST"
        style.stroke-dash: 4

        HubRG.class: resource_group
        HubRG: {
          label: RG-HUB-NETWORK
          grid-columns: 1

          HubVNet.class: network
