# Connections
OnPremDC.CEEdgeRouter -> ConnectivityProvider.ERCircuit: "ER Private Peering (BGP)"
ConnectivityProvider.ERCircuit -> AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.GatewaySubnet.ERGateway: "ER Connection (Primary)"
OnPremDC.CEEdgeRouter -> AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.GatewaySubnet.VPNGateway: "S2S IPsec (Backup)" {
  style.stroke-dash: 5
}
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.GatewaySubnet.ERGateway -> AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.AzureFirewallSubnet.AzureFirewall: "UDR → FW"
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.GatewaySubnet.VPNGateway -> AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.AzureFirewallSubnet.AzureFirewall: "UDR → FW"
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.AzureFirewallSubnet.AzureFirewall <-> AzureTenant.LandingZones.WorkloadASubscription.AustraliaEast.SpokeARG.SpokeAVNet.AppSubnetA.InternalLB_A: "Inspected (0/0 → FW)" {
  style.stroke: "#d32f2f"
  style.stroke-width: 2
}
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.AzureFirewallSubnet.AzureFirewall <-> AzureTenant.LandingZones.WorkloadBSubscription.AustraliaEast.SpokeBRG.SpokeBVNet.AppSubnetB.InternalLB_B: "Inspected (0/0 → FW)" {
  style.stroke: "#d32f2f"
  style.stroke-width: 2
}
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet <-> AzureTenant.LandingZones.WorkloadASubscription.AustraliaEast.SpokeARG.SpokeAVNet: "VNet Peering (GW Transit)" {
  style.stroke-dash: 5
}
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet <-> AzureTenant.LandingZones.WorkloadBSubscription.AustraliaEast.SpokeBRG.SpokeBVNet: "VNet Peering (GW Transit)" {
  style.stroke-dash: 5
}
AzureTenant.LandingZones.WorkloadASubscription.AustraliaEast.SpokeARG.SpokeAVNet.AppSubnetA.InternalLB_A -> AzureTenant.LandingZones.WorkloadASubscription.AustraliaEast.SpokeARG.SpokeAVNet.AppSubnetA.AppVMs_A: "HTTPS 443"
AzureTenant.LandingZones.WorkloadASubscription.AustraliaEast.SpokeARG.SpokeAVNet.AppSubnetA.AppVMs_A -> AzureTenant.LandingZones.WorkloadASubscription.AustraliaEast.SpokeARG.SpokeAVNet.DataSubnetA.PE_SQL_A: "TDS 1433"
AzureTenant.LandingZones.WorkloadASubscription.AustraliaEast.SpokeARG.SpokeAVNet.DataSubnetA.PE_SQL_A -> AzureTenant.LandingZones.WorkloadASubscription.AustraliaEast.SpokeARG.AzureSQL_A: "Private Link"
AzureTenant.LandingZones.WorkloadBSubscription.AustraliaEast.SpokeBRG.SpokeBVNet.AppSubnetB.InternalLB_B -> AzureTenant.LandingZones.WorkloadBSubscription.AustraliaEast.SpokeBRG.SpokeBVNet.AppSubnetB.AppVMs_B: "HTTPS 443"
AzureTenant.LandingZones.WorkloadBSubscription.AustraliaEast.SpokeBRG.SpokeBVNet.AppSubnetB.AppVMs_B -> AzureTenant.LandingZones.WorkloadBSubscription.AustraliaEast.SpokeBRG.SpokeBVNet.DataSubnetB.PE_Storage_B: "HTTPS 443"
AzureTenant.LandingZones.WorkloadBSubscription.AustraliaEast.SpokeBRG.SpokeBVNet.DataSubnetB.PE_Storage_B -> AzureTenant.LandingZones.WorkloadBSubscription.AustraliaEast.SpokeBRG.StorageAccount_B: "Private Link"
OnPremDC.OnPremDNS -> AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.DNSInboundSubnet.DNSInboundEndpoint: "DNS 53 (privatelink)" {
  style.stroke-dash: 5
}
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.DNSInboundSubnet.DNSInboundEndpoint -> AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubServices.PrivateDNSZones: "PE A-Records" {
  style.stroke-dash: 5
}
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.DNSOutboundSubnet.DNSOutboundEndpoint -> OnPremDC.OnPremDNS: "DNS Fwd (corp)" {
  style.stroke-dash: 5
}
OnPremDC.CorpUsers -> AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.AzureBastionSubnet.AzureBastion: "HTTPS 443"
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.AzureBastionSubnet.AzureBastion -> AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.ManagementSubnet.JumpBox: "RDP/SSH"
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubVNet.AzureFirewallSubnet.AzureFirewall -> AzureTenant.Platform.ManagementSubscription.AustraliaEast.MgmtRG.LogAnalytics: "FW Logs" {
  style.stroke-dash: 5
}
AzureTenant.Platform.ConnectivitySubscription.AustraliaEast.HubRG.HubServices.NetworkWatcher -> AzureTenant.Platform.ManagementSubscription.AustraliaEast.MgmtRG.LogAnalytics: "Flow Logs" {
  style.stroke-dash: 5
}
AzureTenant.LandingZones -> AzureTenant.Platform.ManagementSubscription.AustraliaEast.MgmtRG.LogAnalytics: "Diagnostics + AMA" {
