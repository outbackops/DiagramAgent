    style.stroke-width: 2
    style.font-color: "#3949ab"
    style.bold: true
  }
  resource_group: {
    style.fill: "#e1f5fe"
    style.stroke: "#039be5"
    style.border-radius: 8
    style.stroke-width: 2
    style.font-color: "#0277bd"
    style.bold: true
  }
  region: {
    style.fill: "#f5f5f5"
    style.stroke: "#616161"
    style.border-radius: 8
    style.stroke-width: 2
    style.font-color: "#424242"
    style.bold: true
  }
  network: {
    style.fill: "#fff3e0"
    style.stroke: "#ef6c00"
    style.border-radius: 8
    style.stroke-width: 2
    style.font-color: "#e65100"
    style.bold: true
