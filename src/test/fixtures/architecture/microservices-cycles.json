      { "id": "payments", "name": "Payments", "icon": "server", "detail": ".NET 9" },
      { "id": "catalog", "name": "Catalog", "icon": "server", "detail": "Node.js" },
      { "id": "notify", "name": "Notifications", "icon": "notification" }
    ] },
    { "id": "bus", "name": "Event bus", "icon": "kafka", "detail": "Topics per domain" },
