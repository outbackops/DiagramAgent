    { "from": "orders", "to": "orders-db", "meaning": "request", "label": "SQL" },
    { "from": "inventory", "to": "inventory-db", "meaning": "request" },
    { "from": "catalog", "to": "catalog-cache", "meaning": "request" },
    { "from": "catalog", "to": "inventory", "meaning": "request", "label": "Stock level" }
